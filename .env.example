# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Superuser credentials created when the container first starts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vulnchecker

# Full async connection string used by backend and rag services.
DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/vulnchecker

# ── Ollama ────────────────────────────────────────────────────────────────────
# Base URL of the Ollama server running on your VM (reachable from the Docker host).
# Replace with the VM's IP/hostname; the VM must expose port 11434.
OLLAMA_BASE_URL=http://VM_IP_OR_HOSTNAME:11434

# LLM model used by the agent pipeline (backend).
OLLAMA_MODEL=llama3

# Embedding model used by the RAG service.
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Backend auth ──────────────────────────────────────────────────────────────
# Hardcoded admin credentials (no user registration in v1).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Secret key used to sign admin JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret

# ── Inter-service ─────────────────────────────────────────────────────────────
# Internal Docker Compose URL of the RAG micro-service.
RAG_SERVICE_URL=http://rag:8001

# ── Frontend (Vite build-time env vars) ───────────────────────────────────────
# Base URL of the backend API consumed by the user-facing frontend.
VITE_API_URL=http://localhost:8000

# Base URL of the backend API consumed by the admin frontend.
VITE_ADMIN_API_URL=http://localhost:8000
